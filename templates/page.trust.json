    "testing-efficacy": {
      "type": "anchored-content",
      "settings": {
        "anchor": "testing-efficacy",
        "eyebrow": "Testing",
        "heading": "How we test",
        "heading_size": "h1",
        "body": "<p>Where a figure appears anywhere on this site, this is the method behind it.</p><ul><li>Independent consumer panel, 35 participants, ages 25 to 55, across four Indian cities chosen for different climates.</li><li>Eight weeks of twice-daily use, with a two-week washout beforehand.</li><li>Results are <strong>self-assessed by participants</strong>, not measured by instrument. That is a real limitation and it is why our figures are described as perception rather than efficacy.</li></ul><p>Instrumented testing — corneometry for hydration, TEWL for barrier function — is more expensive and more convincing, and we do not have it yet. When we do, it will be published here with the same detail.</p><p>DEVELOPMENT PLACEHOLDER — no panel has been run. Every figure on this site is illustrative until one has.</p>",
        "image_position": "none",
        "link_label": "See the results",
        "link": "/pages/results",
        "link_style_secondary": true,
        "color_scheme": "scheme-2",
        "padding_top": 72,
        "padding_bottom": 72
