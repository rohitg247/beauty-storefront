    "product-safety": {
      "type": "anchored-content",
      "settings": {
        "anchor": "product-safety",
        "eyebrow": "Safety",
        "heading": "Product safety",
        "heading_size": "h1",
        "body": "<p><strong>Patch testing.</strong> Apply a small amount behind the ear or on the inner forearm and leave it for two days. If you are introducing more than one new product, introduce them a fortnight apart — otherwise a reaction tells you nothing about which product caused it.</p><p><strong>If something reacts.</strong> Stop using it. Do not push through, and do not add a soothing product on top. Cleanse gently, use only a plain moisturizer for a few days, and write to us with a photograph.</p><p><strong>Pregnancy and breastfeeding.</strong> This is the most asked safety question in skincare and it is not one a brand should answer for you. Most of our range is generally considered fine, but take the ingredient list to your doctor or obstetrician and follow what they say rather than what a website says.</p>",
        "image_position": "none",
        "link_label": "",
        "link": "",
        "link_style_secondary": true,
        "color_scheme": "scheme-1",
        "padding_top": 72,
        "padding_bottom": 72
      }
