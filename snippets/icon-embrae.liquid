{% comment %}
  Renders one EMBRAE line icon inside a raised chip.

  One icon system for the whole site: 24x24 viewBox, 1.5px stroke, round
  caps and joins, no fills. The Typography doc requires a single
  consistent icon style and rules out mixing filled, outlined and 3D
  sets, so every icon on the site comes from here.

  Stroke colour, weight and the chip surface are all set in brand.css
  (section 16) from colour-scheme custom properties. Nothing here carries
  a colour, which is what lets the same markup sit on cream, white,
  stone or green.

  Accepts:
  - icon:  {String} required. One of the names in the case below.
  - label: {String} optional. Visible text rendered beside the chip.
  - shape: {String} optional. 'square' for the rounded-square variant.
  - class: {String} optional. Extra class on the wrapper.

  Usage:
    {% render 'icon-embrae', icon: 'dermatologist', label: 'Dermatologist tested' %}
    {% render 'icon-embrae', icon: 'whatsapp' %}
{% endcomment %}

{%- liquid
  assign chip_class = 'embrae-chip'
  if shape == 'square'
    assign chip_class = 'embrae-chip embrae-chip--square'
  endif
-%}

<span class="embrae-icon{% if class %} {{ class }}{% endif %}">
  <span class="{{ chip_class }}" aria-hidden="true">
    <svg viewBox="0 0 24 24" role="presentation" focusable="false">
      {%- case icon -%}
        {%- when 'science' -%}
          {%- comment -%} Molecule: three nodes on a bond path. {%- endcomment -%}
          <circle cx="6" cy="7" r="2.2" /><circle cx="18" cy="9" r="2.2" /><circle cx="11" cy="18" r="2.2" />
          <path d="M8 8.2 15.9 9.6M16.6 11 12.4 15.9M9.3 16.4 7 9.2" />
        {%- when 'dermatologist' -%}
          {%- comment -%} Skin patch under review. {%- endcomment -%}
          <path d="M4 6.5h11a4.5 4.5 0 0 1 0 9H8" />
          <path d="M10.5 13 8 15.5 10.5 18" /><path d="M17.5 19.5h3M19 18v3" />
        {%- when 'vegan' -%}
          <path d="M12 20c0-6 3.5-10.5 8-11.5C20 14 16.5 19 12 20Z" />
          <path d="M12 20c-1-4.5-4-7.5-8-8.2C4.6 16 7.8 19.3 12 20Z" />
        {%- when 'cruelty-free' -%}
          {%- comment -%} Rabbit silhouette, the Leaping Bunny convention. {%- endcomment -%}
          <path d="M7.5 12c-2 0-3.5 1.7-3.5 3.8S5.5 20 8 20h7a4 4 0 0 0 0-8h-1" />
          <path d="M9 12.2 7.6 6.4a1.2 1.2 0 0 1 2.1-1l2.6 4.2M12.4 10.6l3.1-3.3a1.2 1.2 0 0 1 1.9 1.4l-2 3.4" />
        {%- when 'recyclable' -%}
          <path d="M8.4 5.9 6.2 9.7M4.6 13.4l2 3.5a1.6 1.6 0 0 0 1.4.8h2.4" />
          <path d="M15.6 5.9h-4.3M17.4 9.4l2.1 3.6M15.9 18.2h-3.6M19.3 14.7l-2 3.5a1.6 1.6 0 0 1-1.4.8" />
          <path d="M9.9 6.7 8.4 5.9 7.6 7.4M4.6 13.4l.4-1.7 1.7.5M12.3 18.2l1.3 1.1-1.3 1.1" />
        {%- when 'small-batch' -%}
          {%- comment -%} Jar with a date band. {%- endcomment -%}
          <path d="M8 4.5h8v2.2a1 1 0 0 1-.4.8l-.6.5v1.5h-6V8l-.6-.5a1 1 0 0 1-.4-.8Z" />
          <rect x="6.5" y="9.5" width="11" height="10" rx="2" /><path d="M6.5 14h11" />
        {%- when 'sensitive' -%}
          {%- comment -%} Barrier shield with a soft centre. {%- endcomment -%}
          <path d="M12 3.5 5 6.2v5.4c0 4.2 2.9 7.6 7 8.9 4.1-1.3 7-4.7 7-8.9V6.2Z" />
          <path d="M9.3 12.2a2.7 2.7 0 0 1 5.4 0c0 1.8-2.7 3.6-2.7 3.6s-2.7-1.8-2.7-3.6Z" />
        {%- when 'clean' -%}
          <path d="M12 3.2c3 3.6 5.6 6.4 5.6 9.6a5.6 5.6 0 1 1-11.2 0c0-3.2 2.6-6 5.6-9.6Z" />
          <path d="M9.2 13.4a2.9 2.9 0 0 0 2.9 2.9" />
        {%- when 'shipping' -%}
          <path d="M3.5 7.5h9v9h-9zM12.5 10.5h4l3 3v3h-7z" />
          <circle cx="7" cy="17.5" r="1.6" /><circle cx="16.5" cy="17.5" r="1.6" />
        {%- when 'secure' -%}
          <rect x="5" y="10.5" width="14" height="9" rx="2" />
          <path d="M8.5 10.5V8a3.5 3.5 0 0 1 7 0v2.5M12 14v2.5" />
        {%- when 'returns' -%}
          <path d="M4.5 12a7.5 7.5 0 1 1 2.5 5.6" /><path d="M4.5 7.5V12H9" />
        {%- when 'whatsapp' -%}
          <path d="M4.5 19.5 5.8 15.7A7.4 7.4 0 1 1 8.6 18.4Z" />
          <path d="M9.4 9.2c.3 1.9 1.5 3.1 3.4 3.4l.9-1.2 1.7 1-.6 1.3c-1.9.5-4.9-1.5-5.9-3.4l1.3-.6Z" />
        {%- when 'email' -%}
          <rect x="3.5" y="5.5" width="17" height="13" rx="2" /><path d="M4 7l8 5.5L20 7" />
        {%- else -%}
          {%- comment -%} Unknown name: render nothing rather than a stray box. {%- endcomment -%}
      {%- endcase -%}
    </svg>
  </span>
  {%- if label != blank -%}
    <span class="embrae-icon__label">{{ label }}</span>
  {%- endif -%}
</span>
