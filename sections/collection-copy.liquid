{% comment %}
  Collection copy — long-form text above or below the product grid.

  Reads collection.metafields.embrae.seo_intro and .seo_outro. Roadmap item 4.5:
  a collection page with nothing but a grid and a one-line description has almost
  no text for a search engine to rank, which is exactly the problem on concern
  and ingredient collections, where the query is informational before it is
  transactional.

  One section, two positions, chosen by the `position` setting — the intro goes
  above the grid and stays short, the outro goes below it and carries the weight.
  Below-the-grid is where the long copy belongs: it ranks the same and it does
  not push the products someone came to see off the screen.

  Same reasoning as sections/product-story.liquid for why this reads the
  metafield in Liquid rather than being a dynamic source on a stock rich-text
  section: a pre-wired dynamic source is stored as bare text in the JSON and
  Shopify's richtext upload validation rejects it.

  EMPTY-SAFE: renders nothing when the metafield is empty, which is every
  collection until someone writes the copy.
{% endcomment %}

{{ 'section-editorial.css' | asset_url | stylesheet_tag }}
{{ 'section-product-modules.css' | asset_url | stylesheet_tag }}

{%- liquid
  if section.settings.position == 'outro'
    assign body = collection.metafields.embrae.seo_outro
  else
    assign body = collection.metafields.embrae.seo_intro
  endif

  assign concern = collection.metafields.embrae.concern.value
-%}

{%- if body != blank and body.value != blank -%}
  <div class="color-{{ section.settings.color_scheme }} gradient">
    <div class="page-width section-{{ section.id }}-padding">
      {%- if section.settings.heading != blank -%}
        <h2 class="product-module__heading {{ section.settings.heading_size }}">
          {{ section.settings.heading }}
        </h2>
      {%- endif -%}

      <div class="product-module__body">
        {{ body | metafield_tag }}
      </div>

      {%- comment -%}
        Link through to the editorial concern page. This is the other half of the
        dual-surface model: the collection is what storefront search can find,
        the concern page is what carries the depth. They have to link both ways
        or neither ranks.
      {%- endcomment -%}
      {%- if section.settings.show_concern_link and concern != blank -%}
        <p class="collection-copy__link">
          <a class="link" href="{{ concern.system.url }}">
            {{- section.settings.concern_link_label | escape }}
            <span class="visually-hidden">: {{ concern.name.value | escape }}</span>
          </a>
        </p>
      {%- endif -%}
    </div>
  </div>
{%- endif -%}

{%- style -%}
  .section-{{ section.id }}-padding {
    padding-top: {{ section.settings.padding_top | times: 0.75 | round: 0 }}px;
    padding-bottom: {{ section.settings.padding_bottom | times: 0.75 | round: 0 }}px;
  }

  @media screen and (min-width: 750px) {
    .section-{{ section.id }}-padding {
      padding-top: {{ section.settings.padding_top }}px;
      padding-bottom: {{ section.settings.padding_bottom }}px;
    }
  }
{%- endstyle -%}

{% schema %}
{
  "name": "Collection copy",
  "tag": "section",
  "class": "section",
  "settings": [
    {
      "type": "select",
      "id": "position",
      "options": [
        { "value": "intro", "label": "Intro (above the grid)" },
        { "value": "outro", "label": "Long-form (below the grid)" }
      ],
      "default": "outro",
      "label": "Which copy",
      "info": "Written per collection in Admin, under the collection's metafields. Renders nothing if empty."
    },
    {
      "type": "inline_richtext",
      "id": "heading",
      "label": "Heading"
    },
    {
      "type": "select",
      "id": "heading_size",
      "options": [
        { "value": "h2", "label": "Small" },
        { "value": "h1", "label": "Medium" },
        { "value": "h0", "label": "Large" }
      ],
      "default": "h2",
      "label": "Heading size"
    },
    {
      "type": "checkbox",
      "id": "show_concern_link",
      "label": "Link to the concern page",
      "default": true,
      "info": "Uses the Concern page metafield on the collection."
    },
    {
      "type": "text",
      "id": "concern_link_label",
      "label": "Concern link label",
      "default": "Read more about this concern"
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "t:sections.all.colors.label",
      "default": "scheme-1"
    },
    {
      "type": "header",
      "content": "t:sections.all.padding.section_padding_heading"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "t:sections.all.padding.padding_top",
      "default": 48
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "t:sections.all.padding.padding_bottom",
      "default": 48
    }
  ],
  "presets": [
    {
      "name": "Collection copy"
    }
  ]
}
{% endschema %}
