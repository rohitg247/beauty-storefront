{% comment %}
  The EMBRAE routine — RESET, DEFEND, ADAPT, PROTECT.

  The Build Brief calls this "a major brand-ownable section" and says it should
  be visually memorable. It was a two-block multicolumn, which is neither.

  What makes it read as an architecture rather than four product tiles is the
  pairing drawn on the boards: a big ordinal number, the action verb, and BOTH
  the product and its texture in the same frame. The texture is what stops four
  near-identical cream bottles from looking like the same photo repeated.

  Every field is a block setting. A merchant must be able to reorder the steps,
  rename them, or drop to three without a deploy — the routine is the brand's
  central claim and it will be edited.

  Responsive:
  - 990+   four across
  - 750-989 two-by-two. Four ~170px cards is the Dawn tablet failure CLAUDE.md
            names specifically, so this band gets an explicit count.
  - <750   snap-scrolling row at 78% width. Four stacked full-height cards
           would be most of a phone screen each and the sequence — which is the
           entire point — stops being visible at a glance.
{% endcomment %}

{{ 'section-routine-architecture.css' | asset_url | stylesheet_tag }}

<div class="color-{{ section.settings.color_scheme }} gradient">
  <div
    {% if section.settings.anchor != blank %}
      id="{{ section.settings.anchor | handleize }}"
    {% endif %}
    class="page-width anchor-target section-{{ section.id }}-padding"
  >
    {%- if section.settings.caption != blank or section.settings.heading != blank -%}
      <div class="routine-arch__header">
        {%- if section.settings.caption != blank -%}
          <p class="routine-arch__caption label">{{ section.settings.caption | escape }}</p>
        {%- endif -%}
        {%- if section.settings.heading != blank -%}
          <h2 class="routine-arch__heading {{ section.settings.heading_size }}">
            {{ section.settings.heading }}
          </h2>
        {%- endif -%}
      </div>
    {%- endif -%}

    <ol class="routine-arch__list" role="list">
      {%- for block in section.blocks -%}
        <li class="routine-arch__item" {{ block.shopify_attributes }}>
          {%- comment -%}
            The number is written out, not generated by a CSS counter: it is
            content, it is read aloud, and a counter would vanish for anyone
            using a screen reader or a text-only view.
          {%- endcomment -%}
          <p class="routine-arch__index" aria-hidden="true">
            {{- forloop.index | prepend: '0' | slice: -2, 2 -}}
          </p>

          <div class="routine-arch__media">
            {%- if block.settings.image != blank -%}
              {{
                block.settings.image
                | image_url: width: 800
                | image_tag:
                  loading: 'lazy',
                  widths: '200, 300, 400, 600, 800',
                  sizes: '(min-width: 990px) 22vw, (min-width: 750px) 44vw, 78vw',
                  class: 'routine-arch__product',
                  alt: block.settings.image.alt
              }}
            {%- endif -%}
            {%- if block.settings.texture != blank -%}
              {%- comment -%}
                Decorative: it repeats what the product image and the copy
                already say, so it gets an empty alt rather than a description
                a screen reader has to sit through four times.
              {%- endcomment -%}
              {{
                block.settings.texture
                | image_url: width: 400
                | image_tag:
                  loading: 'lazy',
                  widths: '120, 200, 300, 400',
                  sizes: '120px',
                  class: 'routine-arch__texture',
                  alt: ''
              }}
            {%- endif -%}
          </div>

          {%- if block.settings.action != blank -%}
            <p class="routine-arch__action">{{ block.settings.action | escape }}</p>
          {%- endif -%}
          {%- if block.settings.text != blank -%}
            <div class="routine-arch__text rte"><p>{{ block.settings.text }}</p></div>
          {%- endif -%}
          {%- if block.settings.link != blank and block.settings.link_label != blank -%}
            <a href="{{ block.settings.link }}" class="routine-arch__link link">
              {{- block.settings.link_label | escape -}}
            </a>
          {%- endif -%}
        </li>
      {%- endfor -%}
    </ol>

    {%- if section.settings.button_label != blank and section.settings.button_link != blank -%}
      <div class="routine-arch__cta">
        <a href="{{ section.settings.button_link }}" class="button">
          {{- section.settings.button_label | escape -}}
        </a>
      </div>
    {%- endif -%}
  </div>
</div>

{% schema %}
{
  "name": "Routine architecture",
  "tag": "section",
  "class": "section",
  "max_blocks": 6,
  "settings": [
    {
      "type": "text",
      "id": "anchor",
      "label": "Anchor id",
      "info": "Lets navigation link straight to this section, e.g. the-routine"
    },
    { "type": "text", "id": "caption", "label": "Caption" },
    { "type": "inline_richtext", "id": "heading", "label": "Heading" },
    {
      "type": "select",
      "id": "heading_size",
      "options": [
        { "value": "h2", "label": "Medium" },
        { "value": "h1", "label": "Large" },
        { "value": "h0", "label": "Extra large" }
      ],
      "default": "h1",
      "label": "Heading size"
    },
    { "type": "text", "id": "button_label", "label": "Button label" },
    { "type": "url", "id": "button_link", "label": "Button link" },
    { "type": "color_scheme", "id": "color_scheme", "default": "scheme-1", "label": "Color scheme" },
    { "type": "header", "content": "Padding" },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "Padding top",
      "default": 72
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "Padding bottom",
      "default": 72
    }
  ],
  "blocks": [
    {
      "type": "step",
      "name": "Routine step",
      "settings": [
        { "type": "text", "id": "action", "label": "Action", "default": "RESET" },
        { "type": "inline_richtext", "id": "text", "label": "Description" },
        { "type": "image_picker", "id": "image", "label": "Product image" },
        {
          "type": "image_picker",
          "id": "texture",
          "label": "Texture image",
          "info": "Optional. Treated as decorative, so it carries an empty alt."
        },
        { "type": "text", "id": "link_label", "label": "Link label" },
        { "type": "url", "id": "link", "label": "Link" }
      ]
    }
  ],
  "presets": [
    {
      "name": "Routine architecture",
      "blocks": [
        { "type": "step" },
        { "type": "step" },
        { "type": "step" },
        { "type": "step" }
      ]
    }
  ]
}
{% endschema %}
