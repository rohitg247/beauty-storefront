{% comment %}
  Main ingredient — renders one `ingredient` metaobject as a full page.

  Used by templates/metaobject.ingredient.json. The public URL is
  /ingredients/<handle>, set by the definition's onlineStore capability
  urlHandle, not by this file.

  The page order follows the architecture diagram's ingredient module:
  ingredient -> benefit -> evidence -> why used -> what it is in.

  This is the SEO half of the dual-surface model. The shoppable half is the
  automated collection linked from the `collection` field: Shopify's storefront
  search returns products, collections, pages and articles, but NOT metaobjects,
  so a customer searching "niacinamide" finds the collection, and the collection
  and this page link to each other.

  EMPTY-SAFE throughout. Every block is behind a blank check, so a
  half-finished entry renders as a short page rather than a broken one.
{% endcomment %}

{{ 'section-editorial.css' | asset_url | stylesheet_tag }}

{%- liquid
  assign title = metaobject.name.value
  assign linked_collection = metaobject.collection.value
  assign products = metaobject.related_products.value
-%}

<div class="color-{{ section.settings.color_scheme }} gradient">
  <div class="page-width section-{{ section.id }}-padding">
    <article class="editorial">
      <header class="editorial__header">
        {%- if metaobject.inci_name.value != blank -%}
          <p class="editorial__eyebrow label">{{ metaobject.inci_name.value | escape }}</p>
        {%- endif -%}

        <h1 class="editorial__title h0">{{ title | escape }}</h1>

        {%- if metaobject.concentration.value != blank -%}
          <p class="editorial__figure">{{ metaobject.concentration.value | escape }}</p>
        {%- endif -%}

        {%- if metaobject.benefit.value != blank -%}
          <p class="editorial__lede">{{ metaobject.benefit.value | escape }}</p>
        {%- endif -%}
      </header>

      {%- if metaobject.image.value != blank -%}
        <figure class="editorial__media">
          {{
            metaobject.image.value
            | image_url: width: 1600
            | image_tag:
              loading: 'lazy',
              widths: '400, 600, 800, 1200, 1600',
              sizes: '(min-width: 990px) 60vw, 92vw',
              class: 'editorial__image',
              alt: title
          }}
        </figure>
      {%- endif -%}

      <div class="editorial__body">
        {%- if metaobject.how_it_works.value != blank -%}
          <section class="editorial__section">
            <h2 class="editorial__section-title h2">{{ section.settings.how_it_works_label | escape }}</h2>
            {{ metaobject.how_it_works | metafield_tag }}
          </section>
        {%- endif -%}

        {%- if metaobject.evidence.value != blank -%}
          <section class="editorial__section">
            <h2 class="editorial__section-title h2">{{ section.settings.evidence_label | escape }}</h2>
            {{ metaobject.evidence | metafield_tag }}
          </section>
        {%- endif -%}
      </div>

      {%- if products != blank and products.size > 0 -%}
        <section class="editorial__section editorial__section--wide">
          <h2 class="editorial__section-title h2">{{ section.settings.products_label | escape }}</h2>

          {%- assign skip_card_product_styles = false -%}
          <ul class="editorial__products grid grid--2-col grid--4-col-desktop list-unstyled" role="list">
            {%- for product in products limit: 8 -%}
              <li class="grid__item">
                {% render 'card-product',
                  card_product: product,
                  media_aspect_ratio: 'portrait',
                  show_secondary_image: true,
                  show_vendor: false,
                  show_rating: false,
                  skip_styles: skip_card_product_styles,
                  section_id: section.id,
                  quick_add: section.settings.quick_add,
                  product_view_context: 'collection'
                %}
              </li>
              {%- assign skip_card_product_styles = true -%}
            {%- endfor -%}
          </ul>
        </section>
      {%- endif -%}

      {%- if linked_collection != blank -%}
        <div class="editorial__footer">
          <a class="button" href="{{ linked_collection.url }}">
            {{- section.settings.collection_label | escape }} {{ linked_collection.title | escape -}}
          </a>
        </div>
      {%- endif -%}
    </article>
  </div>
</div>

{%- style -%}
  .section-{{ section.id }}-padding {
    padding-top: {{ section.settings.padding_top | times: 0.75 | round: 0 }}px;
    padding-bottom: {{ section.settings.padding_bottom | times: 0.75 | round: 0 }}px;
  }

  @media screen and (min-width: 750px) {
    .section-{{ section.id }}-padding {
      padding-top: {{ section.settings.padding_top }}px;
      padding-bottom: {{ section.settings.padding_bottom }}px;
    }
  }
{%- endstyle -%}

{% schema %}
{
  "name": "Ingredient page",
  "tag": "section",
  "class": "section",
  "settings": [
    {
      "type": "paragraph",
      "content": "Content comes from the ingredient entry itself (Settings > Custom data > Metaobjects). These labels are the only editable copy here."
    },
    {
      "type": "text",
      "id": "how_it_works_label",
      "label": "\"How it works\" heading",
      "default": "How it works"
    },
    {
      "type": "text",
      "id": "evidence_label",
      "label": "\"Evidence\" heading",
      "default": "What the evidence says"
    },
    {
      "type": "text",
      "id": "products_label",
      "label": "\"Products\" heading",
      "default": "Where you will find it"
    },
    {
      "type": "text",
      "id": "collection_label",
      "label": "Collection button prefix",
      "default": "Shop all"
    },
    {
      "type": "select",
      "id": "quick_add",
      "options": [
        { "value": "none", "label": "None" },
        { "value": "standard", "label": "Standard" },
        { "value": "bulk", "label": "Bulk" }
      ],
      "default": "standard",
      "label": "Quick add"
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "t:sections.all.colors.label",
      "default": "scheme-1"
    },
    {
      "type": "header",
      "content": "t:sections.all.padding.section_padding_heading"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "t:sections.all.padding.padding_top",
      "default": 64
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "t:sections.all.padding.padding_bottom",
      "default": 96
    }
  ]
}
{% endschema %}
