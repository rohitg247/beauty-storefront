{% comment %}
  Reference row — a card row over a list of metaobject entries.

  Deliberately generic. It serves four places in the architecture:
    - homepage "Ingredient Spotlight"
    - homepage "Which concern matches you?"
    - the Education Hub index (both axes)
    - the concern router page

  Building four near-identical sections instead would have been four schemas to
  keep in sync for no gain.

  Why this needs to be code at all: theme-editor dynamic sources can bind a
  single metafield to a single setting, but they cannot loop. Anything that
  renders a LIST of entries has to be Liquid. Everything in this theme that is
  a single value is wired as a dynamic source instead, with no section file.

  Two pickers, one select: `metaobject_list` settings are pinned to one
  metaobject type, so a single picker cannot offer both ingredients and
  concerns. The `source` select decides which of the two is rendered.

  EMPTY-SAFE: renders absolutely nothing — no wrapper, no padding, no heading —
  when the chosen list is empty. The store has no metaobject entries on day one
  and must not show a hollow band.

  Responsive: snap-scroll on mobile because these are image cards and squeezing
  four of them to 80px would be dishonest; three across the tablet band;
  merchant's count from 990px. Snap is `proximity`, not `mandatory` — mandatory
  snap on a horizontal rail can fight vertical page scroll on iOS.
{% endcomment %}

{{ 'section-reference-row.css' | asset_url | stylesheet_tag }}

{%- liquid
  # Picker first, then every entry of the type. Same reason as skin-quiz: the
  # section is wrapped in a size guard, so an unresolved picker renders an
  # empty band with no error anywhere.
  case section.settings.source
    when 'concern'
      assign entries = section.settings.concerns
      assign fallback = metaobjects.skin_concern.values
      if fallback == blank
        assign fallback = metaobjects.skin_concern
      endif
    when 'routine'
      assign entries = section.settings.routines
      assign fallback = metaobjects.routine.values
      if fallback == blank
        assign fallback = metaobjects.routine
      endif
    else
      assign entries = section.settings.ingredients
      assign fallback = metaobjects.ingredient.values
      if fallback == blank
        assign fallback = metaobjects.ingredient
      endif
  endcase

  if entries == blank or entries.size == 0
    assign entries = fallback
  endif
-%}

{%- if entries != blank and entries.size > 0 -%}
  <div class="color-{{ section.settings.color_scheme }} gradient">
    <div
      {% if section.settings.anchor != blank %}
        id="{{ section.settings.anchor | handleize }}"
      {% endif %}
      class="page-width anchor-target section-{{ section.id }}-padding"
    >
      {%- if section.settings.caption != blank or section.settings.heading != blank -%}
        <div class="reference-row__header section-header">
          {%- if section.settings.caption != blank -%}
            <p class="reference-row__caption label">{{ section.settings.caption | escape }}</p>
          {%- endif -%}

          {%- if section.settings.heading != blank -%}
            <h2 class="reference-row__heading {{ section.settings.heading_size }}">
              {{ section.settings.heading }}
            </h2>
          {%- endif -%}
        </div>
      {%- endif -%}

      <ul
        class="reference-row__grid reference-row__grid--{{ section.settings.columns_desktop }} list-unstyled"
        role="list"
      >
        {%- for entry in entries -%}
          {%- liquid
            assign title = entry.name.value
            case section.settings.source
              when 'concern'
                assign blurb = entry.short_description.value
              when 'routine'
                assign blurb = entry.summary.value
              else
                assign blurb = entry.benefit.value
            endcase
            assign media = entry.image.value
          -%}
          <li class="reference-card">
            <a class="reference-card__link" href="{{ entry.system.url }}">
              {%- if media != blank -%}
                <div class="reference-card__media">
                  {{
                    media
                    | image_url: width: 800
                    | image_tag:
                      loading: 'lazy',
                      widths: '200, 300, 400, 600, 800',
                      sizes: '(min-width: 990px) 22vw, (min-width: 750px) 30vw, 68vw',
                      class: 'reference-card__image',
                      alt: title
                  }}
                </div>
              {%- endif -%}

              <div class="reference-card__body">
                {%- liquid
                  assign meta = ''
                  if section.settings.source == 'ingredient'
                    assign meta = entry.concentration.value
                  elsif section.settings.source == 'routine'
                    assign meta = entry.time_of_day.value
                  endif
                -%}
                {%- if meta != blank -%}
                  <p class="reference-card__meta label">{{ meta | escape }}</p>
                {%- endif -%}

                <h3 class="reference-card__title">{{ title | escape }}</h3>

                {%- if blurb != blank -%}
                  <p class="reference-card__blurb">{{ blurb | escape }}</p>
                {%- endif -%}
              </div>
            </a>
          </li>
        {%- endfor -%}
      </ul>

      {%- if section.settings.link_label != blank and section.settings.link != blank -%}
        <div class="reference-row__footer">
          <a class="button button--secondary" href="{{ section.settings.link }}">
            {{ section.settings.link_label | escape }}
          </a>
        </div>
      {%- endif -%}
    </div>
  </div>
{%- endif -%}

{%- style -%}
  .section-{{ section.id }}-padding {
    padding-top: {{ section.settings.padding_top | times: 0.75 | round: 0 }}px;
    padding-bottom: {{ section.settings.padding_bottom | times: 0.75 | round: 0 }}px;
  }

  @media screen and (min-width: 750px) {
    .section-{{ section.id }}-padding {
      padding-top: {{ section.settings.padding_top }}px;
      padding-bottom: {{ section.settings.padding_bottom }}px;
    }
  }
{%- endstyle -%}

{% schema %}
{
  "name": "Reference row",
  "tag": "section",
  "class": "section",
  "settings": [
    {
      "type": "text",
      "id": "anchor",
      "label": "Anchor id",
      "info": "Link straight to this row from a menu as /pages/<page>#<anchor>. Lowercase, hyphens, no spaces. Leave blank if nothing links here."
    },
    {
      "type": "select",
      "id": "source",
      "options": [
        { "value": "ingredient", "label": "Ingredients" },
        { "value": "concern", "label": "Skin concerns" },
        { "value": "routine", "label": "Routines" }
      ],
      "default": "ingredient",
      "label": "Show",
      "info": "Pick the list below that matches this choice. The others are ignored."
    },
    {
      "type": "metaobject_list",
      "id": "ingredients",
      "metaobject_type": "ingredient",
      "label": "Ingredients"
    },
    {
      "type": "metaobject_list",
      "id": "concerns",
      "metaobject_type": "skin_concern",
      "label": "Skin concerns"
    },
    {
      "type": "metaobject_list",
      "id": "routines",
      "metaobject_type": "routine",
      "label": "Routines"
    },
    {
      "type": "text",
      "id": "caption",
      "label": "Eyebrow"
    },
    {
      "type": "inline_richtext",
      "id": "heading",
      "label": "Heading"
    },
    {
      "type": "select",
      "id": "heading_size",
      "options": [
        { "value": "h2", "label": "Small" },
        { "value": "h1", "label": "Medium" },
        { "value": "h0", "label": "Large" }
      ],
      "default": "h1",
      "label": "Heading size"
    },
    {
      "type": "select",
      "id": "columns_desktop",
      "options": [
        { "value": "3", "label": "3 columns" },
        { "value": "4", "label": "4 columns" },
        { "value": "6", "label": "6 columns" }
      ],
      "default": "4",
      "label": "Columns on desktop",
      "info": "Mobile scrolls sideways and tablet is always 3, so cards never get squeezed below a readable width."
    },
    {
      "type": "text",
      "id": "link_label",
      "label": "Button label"
    },
    {
      "type": "url",
      "id": "link",
      "label": "Button link"
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "t:sections.all.colors.label",
      "default": "scheme-1"
    },
    {
      "type": "header",
      "content": "t:sections.all.padding.section_padding_heading"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "t:sections.all.padding.padding_top",
      "default": 96
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "t:sections.all.padding.padding_bottom",
      "default": 96
    }
  ],
  "presets": [
    {
      "name": "Reference row"
    }
  ]
}
{% endschema %}
