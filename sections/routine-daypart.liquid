{% comment %}
  Routine experience — Morning and Evening.

  Build Brief section 5, row 08. The boards draw two panels side by side:
  Morning on warm cream, Evening on deep green, each with its own CTA.

  The colour flip is the content. Reading a cream panel next to a green one is
  what communicates day and night before a single word is read, which is why
  colour_scheme is a BLOCK setting here rather than a section setting.

  Deliberately two blocks rather than hardcoded panels: a merchant may want a
  third state (travel, monsoon, a seasonal routine), and this store's whole
  proposition is that a routine adapts to conditions.

  Responsive: side by side at 750+, stacked below. Stacking is right here —
  there are only two, they are self-contained, and each one is a decision.
{% endcomment %}

{{ 'section-routine-daypart.css' | asset_url | stylesheet_tag }}

{%- if section.settings.heading != blank or section.settings.caption != blank -%}
  <div class="routine-daypart__header page-width">
    {%- if section.settings.caption != blank -%}
      <p class="routine-daypart__caption caption-with-letter-spacing">{{ section.settings.caption }}</p>
    {%- endif -%}
    {%- if section.settings.heading != blank -%}
      <h2 class="routine-daypart__heading inline-richtext {{ section.settings.heading_size }}">
        {{ section.settings.heading }}
      </h2>
    {%- endif -%}
  </div>
{%- endif -%}

<div
  {% if section.settings.anchor != blank %}
    id="{{ section.settings.anchor | handleize }}"
  {% endif %}
  class="routine-daypart anchor-target section-{{ section.id }}-padding"
>
  {%- for block in section.blocks -%}
    <div
      class="routine-daypart__panel color-{{ block.settings.color_scheme }} gradient"
      {{ block.shopify_attributes }}
    >
      {%- if block.settings.image != blank -%}
        {{
          block.settings.image
          | image_url: width: 1400
          | image_tag:
            loading: 'lazy',
            widths: '400, 600, 800, 1100, 1400',
            sizes: '(min-width: 750px) 50vw, 100vw',
            class: 'routine-daypart__image',
            alt: block.settings.image.alt
        }}
      {%- endif -%}

      <div class="routine-daypart__body">
        {%- if block.settings.heading != blank -%}
          <h3 class="routine-daypart__heading h2">{{ block.settings.heading }}</h3>
        {%- endif -%}
        {%- if block.settings.text != blank -%}
          <div class="routine-daypart__text rte"><p>{{ block.settings.text }}</p></div>
        {%- endif -%}
        {%- if block.settings.steps != blank -%}
          {%- comment -%}
            Split on a comma so the sequence renders as an ordered list rather
            than a sentence. The order is the instruction, and a list is what
            says so to a screen reader.
          {%- endcomment -%}
          <ol class="routine-daypart__steps">
            {%- assign step_items = block.settings.steps | split: ',' -%}
            {%- for step in step_items -%}
              <li>{{ step | strip | escape }}</li>
            {%- endfor -%}
          </ol>
        {%- endif -%}
        {%- if block.settings.button_label != blank and block.settings.button_link != blank -%}
          <a href="{{ block.settings.button_link }}" class="button routine-daypart__button">
            {{- block.settings.button_label | escape -}}
          </a>
        {%- endif -%}
      </div>
    </div>
  {%- endfor -%}
</div>

{% schema %}
{
  "name": "Routine daypart",
  "tag": "section",
  "class": "section",
  "max_blocks": 3,
  "settings": [
    {
      "type": "text",
      "id": "anchor",
      "label": "Anchor id",
      "info": "Lets navigation link straight to this section, e.g. routine-experience"
    },
    { "type": "text", "id": "caption", "label": "Caption" },
    { "type": "inline_richtext", "id": "heading", "label": "Heading" },
    {
      "type": "select",
      "id": "heading_size",
      "options": [
        { "value": "h2", "label": "Small" },
        { "value": "h1", "label": "Medium" },
        { "value": "h0", "label": "Large" }
      ],
      "default": "h1",
      "label": "Heading size"
    },
    { "type": "header", "content": "Padding" },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "Padding top",
      "default": 0
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "Padding bottom",
      "default": 0
    }
  ],
  "blocks": [
    {
      "type": "panel",
      "name": "Panel",
      "settings": [
        { "type": "inline_richtext", "id": "heading", "label": "Heading", "default": "Morning" },
        { "type": "inline_richtext", "id": "text", "label": "Text" },
        {
          "type": "text",
          "id": "steps",
          "label": "Steps",
          "info": "Comma separated. Rendered as a numbered list, e.g. Cleanse, Treat, Moisturize, Protect"
        },
        { "type": "image_picker", "id": "image", "label": "Image" },
        { "type": "text", "id": "button_label", "label": "Button label" },
        { "type": "url", "id": "button_link", "label": "Button link" },
        {
          "type": "color_scheme",
          "id": "color_scheme",
          "default": "scheme-1",
          "label": "Color scheme",
          "info": "The contrast between panels is the point. Light for morning, deep green for evening."
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Routine daypart",
      "blocks": [{ "type": "panel" }, { "type": "panel" }]
    }
  ]
}
{% endschema %}
