{% comment %}
  Product FAQs — PDP module 8.

  Reads product.metafields.embrae.faqs, a list of shared `faq` metaobject
  entries. Shared is the point: the same answer about patch testing appears on
  the FAQ Center and on every product it applies to, and is corrected once.

  Same reasoning as product-ingredients.liquid for why this is a sibling section
  rather than a block inside main-product.liquid.

  Accordion markup and CSS are the theme's existing component-accordion.css and
  the <details>/<summary> pattern, so it works with JS disabled.

  EMPTY-SAFE: renders nothing when the product has no FAQs attached.
{% endcomment %}

{{ 'component-accordion.css' | asset_url | stylesheet_tag }}
{{ 'section-editorial.css' | asset_url | stylesheet_tag }}
{{ 'section-product-modules.css' | asset_url | stylesheet_tag }}

{%- assign faqs = product.metafields.embrae.faqs.value -%}

{%- if faqs != blank and faqs.size > 0 -%}
  <div class="color-{{ section.settings.color_scheme }} gradient">
    <div class="page-width section-{{ section.id }}-padding">
      {%- if section.settings.caption != blank or section.settings.heading != blank -%}
        <div class="product-module__header section-header">
          {%- if section.settings.caption != blank -%}
            <p class="product-module__caption label">{{ section.settings.caption | escape }}</p>
          {%- endif -%}

          {%- if section.settings.heading != blank -%}
            <h2 class="product-module__heading {{ section.settings.heading_size }}">
              {{ section.settings.heading }}
            </h2>
          {%- endif -%}
        </div>
      {%- endif -%}

      <div class="product-module__accordions">
        {%- for entry in faqs -%}
          <div class="accordion">
            <details
              id="Details-pfaq-{{ forloop.index }}-{{ section.id }}"
              {% if section.settings.open_first and forloop.first %}
                open
              {% endif %}
            >
              <summary id="Summary-pfaq-{{ forloop.index }}-{{ section.id }}">
                <h3 class="accordion__title inline-richtext h4">
                  {{ entry.question.value | escape }}
                </h3>
                {{- 'icon-caret.svg' | inline_asset_content -}}
              </summary>
              <div
                class="accordion__content rte"
                role="region"
                aria-labelledby="Summary-pfaq-{{ forloop.index }}-{{ section.id }}"
              >
                {{ entry.answer | metafield_tag }}
              </div>
            </details>
          </div>
        {%- endfor -%}
      </div>

      {%- if section.settings.link_label != blank and section.settings.link != blank -%}
        <div class="product-module__footer">
          <a class="button button--secondary" href="{{ section.settings.link }}">
            {{ section.settings.link_label | escape }}
          </a>
        </div>
      {%- endif -%}
    </div>
  </div>
{%- endif -%}

{%- style -%}
  .section-{{ section.id }}-padding {
    padding-top: {{ section.settings.padding_top | times: 0.75 | round: 0 }}px;
    padding-bottom: {{ section.settings.padding_bottom | times: 0.75 | round: 0 }}px;
  }

  @media screen and (min-width: 750px) {
    .section-{{ section.id }}-padding {
      padding-top: {{ section.settings.padding_top }}px;
      padding-bottom: {{ section.settings.padding_bottom }}px;
    }
  }
{%- endstyle -%}

{% schema %}
{
  "name": "Product FAQs",
  "tag": "section",
  "class": "section",
  "settings": [
    {
      "type": "paragraph",
      "content": "Reads the Product FAQs metafield on each product. Pick from the shared FAQ entries under the product in Admin. Renders nothing if it is empty."
    },
    {
      "type": "text",
      "id": "caption",
      "label": "Eyebrow",
      "default": "Before you buy"
    },
    {
      "type": "inline_richtext",
      "id": "heading",
      "label": "Heading",
      "default": "Questions about this product"
    },
    {
      "type": "select",
      "id": "heading_size",
      "options": [
        { "value": "h2", "label": "Small" },
        { "value": "h1", "label": "Medium" },
        { "value": "h0", "label": "Large" }
      ],
      "default": "h2",
      "label": "Heading size"
    },
    {
      "type": "checkbox",
      "id": "open_first",
      "label": "Open the first question",
      "default": false
    },
    {
      "type": "text",
      "id": "link_label",
      "label": "Button label",
      "default": "All questions"
    },
    {
      "type": "url",
      "id": "link",
      "label": "Button link",
      "info": "Point this at the FAQ Center page."
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "t:sections.all.colors.label",
      "default": "scheme-1"
    },
    {
      "type": "header",
      "content": "t:sections.all.padding.section_padding_heading"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "t:sections.all.padding.padding_top",
      "default": 64
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "t:sections.all.padding.padding_bottom",
      "default": 64
    }
  ],
  "presets": [
    {
      "name": "Product FAQs"
    }
  ]
}
{% endschema %}
