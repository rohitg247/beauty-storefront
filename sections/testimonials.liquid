{% comment %}
  Testimonials — merchant-authored customer quotes.

  These are not verified reviews. If you need verified reviews tied to
  purchases, install a reviews app and use the Rating block on the product
  section instead.
{% endcomment %}

{{ 'component-slider.css' | asset_url | stylesheet_tag }}

{%- style -%}
  .section-{{ section.id }}-padding {
    padding-top: {{ section.settings.padding_top | times: 0.75 | round: 0 }}px;
    padding-bottom: {{ section.settings.padding_bottom | times: 0.75 | round: 0 }}px;
  }

  @media screen and (min-width: 750px) {
    .section-{{ section.id }}-padding {
      padding-top: {{ section.settings.padding_top }}px;
      padding-bottom: {{ section.settings.padding_bottom }}px;
    }
  }
{%- endstyle -%}

<div class="color-{{ section.settings.color_scheme }} gradient">
  <div
    {% if section.settings.anchor != blank %}
      id="{{ section.settings.anchor | handleize }}"
    {% endif %}
    class="page-width anchor-target section-{{ section.id }}-padding isolate"
  >
    {%- unless section.settings.heading == blank and section.settings.eyebrow == blank -%}
      <div class="title-wrapper-with-link title-wrapper--self-padded-tablet-down">
        <div>
          {%- if section.settings.eyebrow != blank -%}
            <p class="label">{{ section.settings.eyebrow | escape }}</p>
          {%- endif -%}
          {%- if section.settings.heading != blank -%}
            <h2 class="title inline-richtext {{ section.settings.heading_size }}">
              {{ section.settings.heading }}
            </h2>
          {%- endif -%}
        </div>
      </div>
    {%- endunless -%}

    {%- if section.blocks.size > 0 -%}
      <ul
        class="testimonials__grid testimonials__grid--{{ section.settings.columns_desktop }}{% if section.settings.enable_mobile_scroll %} testimonials__grid--scroll{% endif %}"
        role="list"
      >
        {%- for block in section.blocks -%}
          <li>
            <figure class="testimonial{% if settings.animations_reveal_on_scroll %} scroll-trigger animate--slide-in{% endif %}"
              {% if settings.animations_reveal_on_scroll %}
                data-cascade
                style="--animation-order: {{ forloop.index }};"
              {% endif %}
              {{ block.shopify_attributes }}
            >
              {%- if block.settings.rating > 0 -%}
                <p class="testimonial__rating" aria-label="Rated {{ block.settings.rating }} out of 5">
                  <span aria-hidden="true">
                    {%- for i in (1..block.settings.rating) -%}★{%- endfor -%}
                    {%- assign empty_stars = 5 | minus: block.settings.rating -%}
                    {%- if empty_stars > 0 -%}
                      {%- for i in (1..empty_stars) -%}☆{%- endfor -%}
                    {%- endif -%}
                  </span>
                </p>
              {%- endif -%}

              {%- if block.settings.quote != blank -%}
                <blockquote class="testimonial__quote">{{ block.settings.quote }}</blockquote>
              {%- endif -%}

              {%- if block.settings.author != blank or block.settings.author_image != blank -%}
                <figcaption class="testimonial__attribution">
                  {%- if block.settings.author_image != blank -%}
                    {{
                      block.settings.author_image
                      | image_url: width: 132
                      | image_tag:
                        loading: 'lazy',
                        widths: '44, 88, 132',
                        sizes: '44px',
                        class: 'testimonial__avatar',
                        alt: block.settings.author
                    }}
                  {%- endif -%}
                  <cite class="testimonial__cite">
                    {%- if block.settings.author != blank -%}
                      <span class="testimonial__name">{{ block.settings.author | escape }}</span>
                    {%- endif -%}
                    {%- if block.settings.author_detail != blank -%}
                      <span class="testimonial__role">{{ block.settings.author_detail | escape }}</span>
                    {%- endif -%}
                  </cite>
                </figcaption>
              {%- endif -%}
            </figure>
          </li>
        {%- endfor -%}
      </ul>
    {%- endif -%}
  </div>
</div>

{% schema %}
{
  "name": "Testimonials",
  "tag": "section",
  "class": "section",
  "disabled_on": {
    "groups": ["header", "footer"]
  },
  "settings": [
    {
      "type": "text",
      "id": "anchor",
      "label": "Anchor id",
      "info": "Link straight to this section from a menu as /pages/<page>#<anchor>. Lowercase, hyphens, no spaces. Leave blank if nothing links here."
    },
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Label above heading",
      "default": "In their words"
    },
    {
      "type": "inline_richtext",
      "id": "heading",
      "label": "Heading",
      "default": "What customers tell us"
    },
    {
      "type": "select",
      "id": "heading_size",
      "options": [
        { "value": "h2", "label": "Medium" },
        { "value": "h1", "label": "Large" },
        { "value": "h0", "label": "Extra large" }
      ],
      "default": "h1",
      "label": "Heading size"
    },
    {
      "type": "range",
      "id": "columns_desktop",
      "min": 2,
      "max": 4,
      "step": 1,
      "default": 3,
      "label": "Columns on desktop"
    },
    {
      "type": "checkbox",
      "id": "enable_mobile_scroll",
      "label": "Swipe sideways on mobile",
      "info": "Turn off to stack quotes vertically instead.",
      "default": true
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "t:sections.all.colors.label",
      "default": "scheme-1"
    },
    {
      "type": "header",
      "content": "t:sections.all.padding.section_padding_heading"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 200,
      "step": 4,
      "unit": "px",
      "label": "t:sections.all.padding.padding_top",
      "default": 96
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 200,
      "step": 4,
      "unit": "px",
      "label": "t:sections.all.padding.padding_bottom",
      "default": 96
    }
  ],
  "blocks": [
    {
      "type": "testimonial",
      "name": "Quote",
      "limit": 9,
      "settings": [
        {
          "type": "richtext",
          "id": "quote",
          "label": "Quote",
          "default": "<p>Six weeks in and the texture on my cheeks has completely evened out. It is the first serum I have finished the bottle of.</p>"
        },
        {
          "type": "range",
          "id": "rating",
          "min": 0,
          "max": 5,
          "step": 1,
          "default": 5,
          "label": "Star rating",
          "info": "Set to 0 to hide the stars."
        },
        {
          "type": "text",
          "id": "author",
          "label": "Name",
          "default": "Ananya R."
        },
        {
          "type": "text",
          "id": "author_detail",
          "label": "Detail below name",
          "info": "City, skin type, or which product they bought.",
          "default": "Verified buyer — Vitamin C Serum"
        },
        {
          "type": "image_picker",
          "id": "author_image",
          "label": "Photo"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Testimonials",
      "blocks": [{ "type": "testimonial" }, { "type": "testimonial" }, { "type": "testimonial" }]
    }
  ]
}
{% endschema %}
